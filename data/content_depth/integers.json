      "content_status": "scaffold",
      "archetypes": [
        {
          "id": "depth.v1.integers.signed_numbers.concept",
          "reasoning_kind": "conceptual",
          "prompt_prefix": "Which mental model best supports Signed numbers?"
        },
        {
          "id": "depth.v1.integers.signed_numbers.procedure",
          "reasoning_kind": "procedural"
        },
        {
          "id": "depth.v1.integers.signed_numbers.transfer",
          "reasoning_kind": "transfer"
        },
        {
          "id": "depth.v1.integers.signed_numbers.application",
          "reasoning_kind": "application",
          "prompt_prefix": "A temperature or elevation change must be modeled; choose a signed-number model and solve."
        }
      ],
      "worked_example": {
        "title": "Worked example: Signed numbers",
        "steps": [
          {
            "stage": "model",
            "prompt": "Simplify this expression: (-4 + 6) * -4",
            "explanation": "Apply parentheses first, then multiplication, and finally addition and subtraction. Answer: -8",
            "expected_answer": "-8"
          },
          {
            "stage": "guided",
            "prompt": "Simplify this expression: (8 * 4) + (-3 * -3)",
            "explanation": "Place -4 and 3 on a number line and say which is greater.",
            "expected_answer": "41"
          },
          {
            "stage": "transfer",
            "prompt": "Simplify this expression: (-6 + 11) - (-2 * 2)",
            "explanation": "Solve independently, then compare with the worked strategy.",
            "expected_answer": "9"
          }
        ]
      },
      "misconceptions": [
        {
          "code": "signed_numbers.model_confusion",
          "feedback": "Ignoring the sign and comparing only the digits.",
          "hint": "The sign tells direction or side of zero, not just size.",
          "recovery_archetype_id": "depth.v1.integers.signed_numbers.concept"
        },
        {
          "code": "signed_numbers.procedure_slip",
          "feedback": "The setup is close, but a step in Signed numbers changed the result.",
          "hint": "Place -4 and 3 on a number line and say which is greater.",
          "recovery_archetype_id": "depth.v1.integers.signed_numbers.procedure"
        }
      ]
    },
