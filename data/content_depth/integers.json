      "worked_example": {
        "title": "Worked example: Order-dependent operations",
        "steps": [
          {
            "stage": "model",
            "prompt": "Simplify this expression: -4 - (2 * -2)",
            "explanation": "Apply parentheses first, then multiplication, and finally addition and subtraction. Answer: 0",
            "expected_answer": "0"
          },
          {
            "stage": "guided",
            "prompt": "Simplify this expression: (3 + 1) - (4 * 2)",
            "explanation": "Compare 6 - (-2) with (-2) - 6 and explain the difference.",
