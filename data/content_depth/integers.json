          },
          {
            "stage": "transfer",
            "prompt": "Simplify this expression: -9 - (0 * -6)",
            "explanation": "Solve independently, then compare with the worked strategy.",
            "expected_answer": "-9"
          }
        ]
      },
      "misconceptions": [
        {
          "code": "order_dependent_operations.model_confusion",
          "feedback": "Assuming subtraction and division behave like commutative operations.",
          "hint": "With negatives, operation order matters because each step changes the next input.",
          "recovery_archetype_id": "depth.v1.integers.order_dependent_operations.concept"
        },
        {
          "code": "order_dependent_operations.procedure_slip",
          "feedback": "The setup is close, but a step in Order-dependent operations changed the result.",
          "hint": "Compare 6 - (-2) with (-2) - 6 and explain the difference.",
