    "answer_expr": "end - start",
    "constraint_expr": "end > start",
    "explanation_template": "Elapsed time is the ending time minus the starting time.",
    "min_level": 1,
    "max_level": 3,
    "choice_spread": 10.0,
    "active": true,
    "vars": [
      {
        "name": "start",
        "min": 5,
        "max": 120,
        "step": 5,
        "kind": "int"
      },
      {
        "name": "end",
        "min": 10,
        "max": 180,
        "step": 5,
        "kind": "int"
      }
    ]
  }
]
